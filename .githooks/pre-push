#!/bin/sh
#
# Verifies formatting and code style for the .cs files being pushed, so CI does
# not have to be the one to tell you.
#
# Enable once per clone:  git config core.hooksPath .githooks
# Skip a single push:     git push --no-verify
#
# Only the .cs files being pushed are checked. CI checks the whole solution.
#
# This is a pre-push rather than the more usual pre-commit hook: dotnet format
# has to load the MSBuild workspace before it can check anything, which costs
# ~20s here however few files are passed to it. That is fine once per push and
# far too slow once per commit.

# All-zero object id: 40 characters for SHA-1 repositories, 64 for SHA-256.
zero=$(git hash-object --stdin </dev/null | tr '0-9a-f' 0)

head_ref=$(git symbolic-ref -q HEAD)
files=""

while read -r local_ref local_sha remote_ref remote_sha; do
    # Branch deletion: nothing to check.
    [ "$local_sha" = "$zero" ] && continue

    # dotnet format reads files from disk, so the check is only meaningful for
    # the branch that is actually checked out.
    if [ "$local_ref" != "$head_ref" ]; then
        echo "pre-push: $local_ref is not checked out; skipping its check." >&2
        continue
    fi

    if [ "$remote_sha" != "$zero" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
        # Updating an existing remote branch: check what the remote does not have.
        base="$remote_sha"
    else
        # New branch, or a remote commit this clone does not have. Use the oldest
        # commit that is not on any remote-tracking branch, so that commits
        # already published anywhere (notably upstream/main) drop out. Basing
        # this on origin/main instead would drag in everything a stale fork is
        # missing.
        oldest=$(git rev-list "$local_sha" --not --remotes | tail -1)
        if [ -n "$oldest" ] && git rev-parse -q --verify "$oldest^" >/dev/null; then
            base="$oldest^"
        else
            base=""
        fi
    fi

    if [ -z "$base" ]; then
        echo "pre-push: cannot determine what is being pushed for $local_ref; skipping its check." >&2
        continue
    fi

    files="$files
$(git diff --name-only --diff-filter=ACM "$base..$local_sha" -- '*.cs')"
done

files=$(printf '%s\n' "$files" | grep -v '^$' | sort -u)

# An empty --include is ignored by dotnet format, which would then check the
# whole solution. Bail out instead.
if [ -z "$files" ]; then
    exit 0
fi

# Checking a very large set is slow enough that it would just get bypassed, and
# it usually means the range was computed from an unexpected starting point.
count=$(printf '%s\n' "$files" | wc -l | tr -d ' ')
if [ "$count" -gt 100 ]; then
    echo "pre-push: $count changed .cs files is more than this hook will check." >&2
    echo "pre-push: run 'dotnet format CSharpDriver.sln --verify-no-changes' yourself if needed." >&2
    exit 0
fi

# Build the argument list one path at a time: splitting on newlines only (so
# paths containing spaces survive) and with globbing off (so a path containing
# * or ? is not expanded against the working directory).
set -f
set --
saved_ifs=$IFS
IFS='
'
for file in $files; do
    set -- "$@" "$file"
done
IFS=$saved_ifs
set +f

echo "pre-push: verifying formatting and code style..."
if ! dotnet format CSharpDriver.sln --verify-no-changes --include "$@"; then
    echo "" >&2
    echo "pre-push: formatting or code style issues found. Fix them with:" >&2
    echo "" >&2
    echo "  dotnet format CSharpDriver.sln --include $*" >&2
    echo "" >&2
    echo "Naming violations cannot be fixed automatically and need a manual rename." >&2
    echo "" >&2
    echo "To push anyway: git push --no-verify" >&2
    exit 1
fi
