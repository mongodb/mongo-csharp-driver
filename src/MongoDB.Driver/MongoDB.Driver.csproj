<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyTitle>MongoDB.Driver</AssemblyTitle>
    <Product>MongoDB.Driver</Product>
    <PackageId>MongoDB.Driver</PackageId>
    <Description>Official MongoDB supported driver for MongoDB. See https://www.mongodb.com/docs/drivers/csharp/ for more details.</Description>
    <PackageDescription>Official .NET driver for MongoDB.</PackageDescription>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DnsClient" Version="1.6.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="2.0.0" />
    <PackageReference Include="SharpCompress" Version="0.48.1" />
    <PackageReference Include="Snappier" Version="1.3.1" />
    <PackageReference Include="ZstdSharp.Port" Version="0.7.3" />
  </ItemGroup>

  <!-- Polyfills that are only needed on .NET Framework; the types they provide are in-box on .NET 6.0 and later. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <PackageReference Include="System.Buffers" Version="4.6.1" />
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="6.0.1" />
    <PackageReference Include="System.Runtime.InteropServices.RuntimeInformation" Version="4.3.0" />
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MongoDB.Bson\MongoDB.Bson.csproj" />
  </ItemGroup>

  <!-- The Public Suffix List, vendored from the drivers specifications repository at
       source/public-suffix-list/public_suffix_list.dat and read by PublicSuffixList.cs.
       It is embedded rather than shipped alongside the assembly because NuGet content files do
       not reach transitive consumers and are not bundled by single-file publish. The file is
       generated upstream and must not be edited by hand; refresh it from the specifications
       repository. LogicalName is set explicitly so renaming the folder cannot silently change
       the resource name the loader asks for. -->
  <ItemGroup>
    <EmbeddedResource Include="Core\Misc\public_suffix_list.dat" LogicalName="MongoDB.Driver.Core.Misc.public_suffix_list.dat" />
  </ItemGroup>

  <PropertyGroup>
    <NoWarn>NU5100</NoWarn>
  </PropertyGroup>

  <!-- An empty netstandard2.0 asset group, so NuGet considers this package directly
       compatible with netstandard2.0 and never applies AssetTargetFallback to it. Without
       it, a .NET Standard or pre-6.0 .NET Core project is silently given lib/net472 with
       only warning NU1701; with it, no assemblies resolve and MongoDB.Bson's guard reports
       MONGO1001 instead. Compatibility is computed per package, so MongoDB.Bson's guard
       does not cover this one. See src/MongoDB.Bson/build/MongoDB.Bson.targets. -->
  <ItemGroup>
    <None Include="..\MongoDB.Shared\EmptyPackageAssetPlaceholder\_._" Pack="true" PackagePath="buildTransitive\netstandard2.0" />
  </ItemGroup>

</Project>
